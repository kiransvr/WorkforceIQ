# WorkforceIQ — Environment Variables
# Copy to .env (root) for local development. Never commit .env to source control.

# ─── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workforceiq
POSTGRES_USER=workforceiq_user
POSTGRES_PASSWORD=change_me_in_production

# ─── Redis ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# ─── API ──────────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001
NODE_ENV=development

# ─── Web ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
WEB_URL=http://localhost:3000
WEB_PORT=3000

# ─── Object Storage (MinIO / S3-compatible) ───────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=workforceiq-docs
STORAGE_REGION=us-east-1

# ─── AI (Anthropic Claude) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-change_me

# ─── Encryption (field-level: national ID, bank account, salary) ──
# 32-byte hex key. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=

# ─── Local development organization/admin seed ──────────────────
# Required by `pnpm db:setup`. Use your own local-only password (12+ characters).
DEMO_ADMIN_EMAIL=admin@workforceiq.local
DEMO_ADMIN_PASSWORD=
SEED_ORGANIZATION_NAME=WorkforceIQ Local
SEED_COUNTRY_CODE=ET
SEED_CURRENCY_CODE=ETB

# ─── Email (for notifications / report delivery) ──────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=change_me
SMTP_FROM="WorkforceIQ <noreply@example.com>"
